# CAD viewer conversion caches
/models/**/.*.step.glb
/models/**/.*.generation.lock.json

# Ad hoc CAD inspection output and revision-specific render jobs.
# Keep new runs under dist/enclosure/; these paths cover older commands.
/models/broglow/[cC][aA][dD]-[iI][nN][sS][pP][eE][cC][tT][iI][oO][nN].[jJ][sS][oO][nN]
/models/broglow/[cC][oO][uU][pP][oO][nN]-[iI][nN][sS][pP][eE][cC][tT][iI][oO][nN].[jJ][sS][oO][nN]
/models/broglow/[uU][sS][bB]-[cC][oO][uU][pP][oO][nN]-[iI][nN][sS][pP][eE][cC][tT][iI][oO][nN].[jJ][sS][oO][nN]

# Generated CAD renders, dimensions and disposable preview files.
/models/broglow/preview/

# Photo originals stay local; the website tracks web-sized copies only.
site/assets/photos/originals/
